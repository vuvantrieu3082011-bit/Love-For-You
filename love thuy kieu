body{
    margin:0;
    overflow:hidden;
    background:linear-gradient(135deg,#ff9ecb,#ffd6e7);
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    font-family:Arial,sans-serif;
}

h1{
    color:white;
    font-size:50px;
    text-align:center;
    text-shadow:0 0 20px hotpink;
}

#cat{
    position:fixed;
    bottom:20px;
    left:-150px;
    width:120px;
